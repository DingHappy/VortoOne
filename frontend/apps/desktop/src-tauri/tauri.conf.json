{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VortoOne",
  "version": "0.8.9",
  "identifier": "com.vorto.vortoone.desktopbase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "VortoOne",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "welcome",
        "create": false,
        "url": "index.html",
        "title": "VortoOne",
        "width": 720,
        "height": 600,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "prefs",
        "create": false,
        "url": "index.html",
        "title": "VortoOne",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "agenteschat"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "VortoOne desktop foundation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/agentes-runner",
      "binaries/agent-browser"
    ],
    "resources": {
      "../../../NOTICE": "NOTICE",
      "licenses/agent-browser/*": "licenses/agent-browser/",
      "licenses/bun/*": "licenses/bun/"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
