{
  "name": "vortoone-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vortoone/web",
    "build": "npm run build --workspace @vortoone/web && npm run desktop:build",
    "build:preview": "node scripts/build-desktop-preview.mjs",
    "preview": "npm run preview --workspace @vortoone/web",
    "typecheck": "npm run typecheck --workspace @vortoone/web && npm run typecheck --workspace @vortoone/desktop && npm run runtime:typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "brand:generate": "node scripts/generate-brand.mjs && npm run icons --workspace @vortoone/desktop && npm exec --workspace @vortoone/desktop -- tauri icon app-icon.png --output src-tauri/icons",
    "check": "npm run typecheck && npm test && npm run build",
    "desktop:dev": "npm run dev --workspace @vortoone/desktop -- --port 1421",
    "desktop:build": "npm run build --workspace @vortoone/desktop",
    "desktop-dev:bundle": "node scripts/desktop-dev.mjs bundle",
    "desktop-dev:install": "node scripts/desktop-dev.mjs install",
    "desktop-dev:check-installed": "node scripts/desktop-dev.mjs check-installed",
    "desktop-dev:status": "node scripts/desktop-dev.mjs status",
    "desktop-dev:version": "node scripts/desktop-dev.mjs version",
    "desktop-dev:manage": "node scripts/desktop-dev.mjs manage",
    "desktop-dev:draft": "node scripts/desktop-dev.mjs draft",
    "runtime:dev": "npm run dev --workspace @vortoone/web -- --config vite.runtime.config.ts",
    "runtime:typecheck": "tsc -p apps/web/tsconfig.vortoone.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ws": "^8.23.0"
  }
}
